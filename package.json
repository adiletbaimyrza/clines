{
  "name": "clines",
  "version": "5.12.0",
  "description": "Count lines of code per language, find duplicate code, rank files by code complexity, estimate the token count of a repository for AI agents, find stale comments, and decide which files are worth refactoring. A modern cloc alternative.",
  "type": "module",
  "homepage": "https://adiletbaimyrza.github.io/clines/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adiletbaimyrza/clines.git"
  },
  "bin": {
    "clines": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stage:list": "npx --yes npm@latest stage list clines",
    "deploy": "npx --yes npm@latest stage approve",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "count",
    "lines",
    "lines-of-code",
    "loc",
    "cloc",
    "cloc-alternative",
    "code-metrics",
    "static-analysis",
    "complexity",
    "code-complexity",
    "duplication",
    "code-duplication",
    "duplicate-code",
    "copy-paste-detector",
    "token",
    "token-count",
    "context-window",
    "stale-comments",
    "code-comments",
    "git-blame",
    "refactoring",
    "code-hotspots",
    "ai",
    "cli",
    "code-quality",
    "developer-tools",
    "nodejs",
    "tokens",
    "typescript",
    "comment-drift",
    "token-estimate",
    "code-churn",
    "technical-debt",
    "codebase-metrics",
    "hotspots"
  ],
  "license": "MIT",
  "author": "Adilet Baimyrza Uulu",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.2.7"
  }
}
