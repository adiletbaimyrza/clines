{
  "name": "clines",
  "version": "4.4.0",
  "description": "Count lines of code, comments and blanks per language, find duplicate code, rank files by complexity, estimate the token cost of a repository, and find stale comments. A modern cloc alternative.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adiletbaimyrza/clines.git"
  },
  "bin": {
    "clines": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stage:list": "npm stage list clines",
    "deploy": "npm stage approve",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "count",
    "lines",
    "loc",
    "cloc",
    "code-metrics",
    "static-analysis",
    "complexity",
    "duplicate-code",
    "tokens",
    "context-window",
    "stale-comments",
    "code-comments",
    "git-blame",
    "ai",
    "project"
  ],
  "license": "MIT",
  "author": "Adilet Baimyrza Uulu",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "commander": "^13.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.2.7"
  }
}
